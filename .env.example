# Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgres://angimom:angimom_password@localhost:5432/angimom_db
POSTGRES_USER=angimom
POSTGRES_PASSWORD=angimom_password
POSTGRES_DB=angimom_db
POSTGRES_PORT=5432

# Authentication & Session (Web Crypto HMAC-SHA256)
# BẮT BUỘC: Khóa ngẫu nhiên mật mã tối thiểu 32 ký tự (sinh bằng: openssl rand -base64 32).
# Tuyệt đối không dùng chuỗi mặc định hoặc placeholder (hệ thống sẽ fail-closed).
AUTH_SECRET=

# Cloud Object Storage (Cloudflare R2 / AWS S3) — Tùy chọn, để trống sẽ dùng Local Disk Fallback
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=angimom-media
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://media.angimom.vn
# Hoặc dùng định dạng S3 tương thích
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=angimom-media
S3_PUBLIC_DOMAIN=https://media.angimom.vn

# Transactional Email (Resend hoặc SMTP) — Tùy chọn, để trống sẽ dùng Dev Mock Logger
RESEND_API_KEY=
EMAIL_FROM=Ăn Gì Mom <no-reply@angimom.vn>

# Dev seed accounts (src/scripts/seed_catalog.ts) — đặt mật khẩu mạnh, >= 12 ký tự; để trống sẽ bỏ qua tạo tài khoản
SEED_ADMIN_PASSWORD=
SEED_EDITOR_PASSWORD=

# Cloudflare Turnstile (chống Bot trang Đăng ký). Production bắt buộc có SECRET; dev để trống = bỏ qua.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
