# Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgres://angimom:angimom_password@localhost:5432/angimom_db
POSTGRES_USER=angimom
POSTGRES_PASSWORD=angimom_password
POSTGRES_DB=angimom_db
POSTGRES_PORT=5432

# Authentication & Session (NextAuth / IronSession)
AUTH_SECRET=super_secret_session_key_min_32_characters_long_angimom

# Cloud Object Storage (Cloudflare R2 / AWS S3) — Tùy chọn, để trống sẽ dùng Local Disk Fallback
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=angimom-media
S3_PUBLIC_DOMAIN=https://media.angimom.vn

# Transactional Email (Resend hoặc SMTP) — Tùy chọn, để trống sẽ dùng Dev Mock Logger
RESEND_API_KEY=
EMAIL_FROM=Ăn Gì Mom <no-reply@angimom.vn>

# Dev seed accounts (src/scripts/seed_catalog.ts) — đặt mật khẩu mạnh, >= 12 ký tự; để trống sẽ bỏ qua tạo tài khoản
SEED_ADMIN_PASSWORD=
SEED_EDITOR_PASSWORD=
