# Caddy Production Reverse Proxy — Tự động cấp SSL HTTPS miễn phí và nén Zstandard/Gzip
{
    email {$ACME_EMAIL:trieunt6@matbao.com}
    admin off
}

{$DOMAIN_NAME:localhost} {
    # Nén dữ liệu truyền tải
    encode zstd gzip

    # Reverse proxy tới Next.js container trên cổng 3000
    reverse_proxy app:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Cache tiêu chuẩn cho tài nguyên tĩnh Next.js
    @static {
        path /_next/static/* /images/* /favicon.ico /manifest.json
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
