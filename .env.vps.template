# ==============================================================================
# ANGIMOM VPS / MẮT BÃO VIBE HOST CONFIGURATION TEMPLATE
# Liên hệ kỹ thuật: trieunt6@matbao.com
# Hướng dẫn: Trên VPS Mắt Bão, copy file này thành .env.production và điền khóa bí mật:
#   cp .env.vps.template .env.production
#   nano .env.production
# ==============================================================================

NODE_ENV=production

# Tên miền chính hoặc Subdomain chạy trên VPS (VD: angimom.vn hoặc test.angimom.vn)
# Nếu chưa trỏ domain thì để IP máy chủ (Caddy sẽ mở HTTP port 80)
DOMAIN_NAME=angimom.vn

# Email nhận thông báo cấp chứng chỉ SSL tự động từ Let's Encrypt / ZeroSSL
ACME_EMAIL=trieunt6@matbao.com

# URL gốc chính thức của website (dùng trong link email đặt lại mật khẩu).
# BẮT BUỘC đúng tên miền thật, ví dụ: https://angimom.vn
APP_URL=https://angimom.vn

# ------------------------------------------------------------------------------
# 1. Cơ sở dữ liệu PostgreSQL 16 (chạy cô lập trong Docker network)
# ------------------------------------------------------------------------------
POSTGRES_USER=angimom
# BẮT BUỘC: Thay đổi mật khẩu DB mạnh ngẫu nhiên
POSTGRES_PASSWORD=DatMatKhauDBSieuManhChoVPS_MatBao_2026!
POSTGRES_DB=angimom_prod

# ------------------------------------------------------------------------------
# 2. Khóa bảo mật ký phiên đăng nhập (AUTH_SECRET)
# BẮT BUỘC: Tối thiểu 32 ký tự, sinh bằng lệnh: openssl rand -base64 32
# ------------------------------------------------------------------------------
AUTH_SECRET=SinhKhoaNgauNhienItNhat32KyTuBangLenhOpensslRandBase64_32

# ------------------------------------------------------------------------------
# 3. Cloudflare R2 Object Storage (Lưu trữ ảnh món ăn)
# Tùy chọn: Nếu chưa cấu hình, hệ thống tự động lưu vào ổ cứng local (/public/uploads)
# ------------------------------------------------------------------------------
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=angimom-media
CLOUDFLARE_R2_PUBLIC_DOMAIN=

# ------------------------------------------------------------------------------
# 4. Email Transactional (Gửi mã xác thực / Quên mật khẩu qua SMTP Mắt Bão)
# Tùy chọn: Nếu chưa điền, hệ thống ghi log reset link nội bộ an toàn
# ------------------------------------------------------------------------------
SMTP_HOST=mail.angimom.vn
SMTP_PORT=465
SMTP_USER=trieunt6@matbao.com
SMTP_PASS=
SMTP_FROM=Ăn Gì Mom <trieunt6@matbao.com>

